{
  "name": "docs-management-fe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --mode development",
    "dev:prod": "vite --host 0.0.0.0 --mode production",
    "build": "tsc -b && vite build",
