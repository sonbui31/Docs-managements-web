generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  DEPLOYED
  APPROVED
  SIGNED_OFF
  ARCHIVED
}

enum CommentStatus {
  OPEN
  RESOLVED
}

enum ImportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum GlobalRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum ProjectRole {
  VIEWER
  REVIEWER
  EDITOR
  MANAGER
}

enum TokenType {
  EMAIL_CONFIRMATION
  PASSWORD_RESET
}

enum WorkItemType {
  TASK
  BUG
  REVIEW
  CHANGE_REQUEST
  QUESTION
}

enum WorkItemStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  BLOCKED
  DONE
}

enum WorkItemPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkboardColumnType {
  INTAKE
  READY
  OPEN
  IN_PROGRESS
  REVIEW
  QA
  WAITING
  BLOCKED
  REWORK
  APPROVED
  DONE
  ARCHIVED
}

model Project {
  id                   String               @id @default(cuid())
  code                 String               @unique
  name                 String
  client               String?
  description          String?
  externalCompanyId    String?
  externalDepartmentId String?
  documents            Document[]
  mediaAssets          MediaAsset[]
  importJobs           ImportJob[]
  requirementTags      RequirementTag[]
  traceLinks           TraceLink[]
  workItems            WorkItem[]
  workItemLabels       WorkItemLabel[]
  workboardColumns     WorkboardColumn[]
  members              ProjectMember[]
  documentPermissions  DocumentPermission[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([externalCompanyId, externalDepartmentId])
}

model Document {
  id                   String               @id @default(cuid())
  projectId            String
  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                String
  type                 String
  status               DocumentStatus       @default(DRAFT)
  currentVersion       String               @default("v0.1")
  htmlContent          String
  sourceType           String               @default("manual")
  sourceFileName       String?
  externalCompanyId    String?
  externalDepartmentId String?
  createdBy            String?
  createdByEmail       String?
  versions             DocumentVersion[]
  comments             Comment[]
  mediaAssets          MediaAsset[]
  requirementTags      RequirementTag[]
  traceLinksFrom       TraceLink[]          @relation("TraceSourceDocument")
  traceLinksTo         TraceLink[]          @relation("TraceTargetDocument")
  workItems            WorkItem[]
  importJob            ImportJob?
  permissions          DocumentPermission[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([projectId])
  @@index([externalCompanyId, externalDepartmentId])
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  passwordHash         String
  name                 String
  globalRole           GlobalRole           @default(EMPLOYEE)
  externalUserId       String?              @unique
  externalRole         String?
  externalCompanyId    String?
  externalDepartmentId String?
  status               UserStatus           @default(ACTIVE)
  failedLoginAttempts  Int                  @default(0)
  lockedUntil          DateTime?
  emailConfirmedAt     DateTime?
  deletedAt            DateTime?
  refreshSessions      RefreshSession[]
  projectMemberships   ProjectMember[]
  documentPermissions  DocumentPermission[]
  notifications        Notification[]
  documentTemplates    DocumentTemplate[]
  verificationTokens   VerificationToken[]
  auditLogs            AuditLog[]           @relation("AuditActor")
  assignedWorkItems    WorkItem[]           @relation("WorkItemAssignee")
  workItemAssignments  WorkItemAssignee[]
  createdWorkItems     WorkItem[]           @relation("WorkItemCreator")
  workItemComments     WorkItemComment[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([globalRole, status])
  @@index([externalCompanyId, externalDepartmentId])
}

model RefreshSession {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash            String    @unique
  externalAccessToken  String?
  externalRefreshToken String?
  userAgent            String?
  ipAddress            String?
  expiresAt            DateTime
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())
  lastUsedAt           DateTime?

  @@index([userId, expiresAt])
}

model ProjectMember {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       ProjectRole   @default(VIEWER)
  roles      ProjectRole[] @default([VIEWER])
  assignedBy String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([projectId, userId])
  @@index([userId, role])
}

model DocumentPermission {
  id         String        @id @default(cuid())
  documentId String
  document   Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       ProjectRole   @default(VIEWER)
  roles      ProjectRole[] @default([VIEWER])
  assignedBy String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([documentId, userId])
  @@index([projectId, userId])
}

model VerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  type       TokenType
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, type, expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version     String
  htmlContent String
  changeNote  String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@unique([documentId, version])
}

model Comment {
  id             String        @id @default(cuid())
  documentId     String
  document       Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parentId       String?
  blockId        String
  selectedText   String?
  content        String
  status         CommentStatus @default(OPEN)
  createdBy      String?
  createdByEmail String?
  resolvedBy     String?
  workItems      WorkItem[]
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  @@index([documentId, blockId])
  @@index([parentId])
}

model WorkItem {
  id              String                  @id @default(cuid())
  projectId       String
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId      String?
  document        Document?               @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sourceCommentId String?
  sourceComment   Comment?                @relation(fields: [sourceCommentId], references: [id], onDelete: SetNull)
  type            WorkItemType            @default(TASK)
  status          WorkItemStatus          @default(BACKLOG)
  columnId        String?
  column          WorkboardColumn?        @relation(fields: [columnId], references: [id], onDelete: SetNull)
  priority        WorkItemPriority        @default(MEDIUM)
  title           String
  description     String?
  attachments     Json?
  assigneeId      String?
  assignee        User?                   @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeName    String?
  assignees       WorkItemAssignee[]
  checklistItems  WorkItemChecklistItem[]
  labels          WorkItemLabelLink[]
  blockingLinks   WorkItemDependency[]    @relation("WorkItemBlocked")
  blockedLinks    WorkItemDependency[]    @relation("WorkItemBlocker")
  dueDate         DateTime?
  createdById     String?
  createdBy       User?                   @relation("WorkItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName   String?
  createdByEmail  String?
  comments        WorkItemComment[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([projectId, status, priority])
  @@index([columnId])
  @@index([documentId])
  @@index([sourceCommentId])
  @@index([assigneeId])
}

model WorkboardColumn {
  id        String              @id @default(cuid())
  projectId String
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  name      String
  color     String              @default("#6366f1")
  type      WorkboardColumnType @default(OPEN)
  position  Int                 @default(0)
  isDefault Boolean             @default(false)
  isDone    Boolean             @default(false)
  workItems WorkItem[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([projectId, key])
  @@index([projectId, position])
}

model WorkItemAssignee {
  id         String   @id @default(cuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy String?
  createdAt  DateTime @default(now())

  @@unique([workItemId, userId])
  @@index([userId])
}

model WorkItemChecklistItem {
  id         String   @id @default(cuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  title      String
  done       Boolean  @default(false)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([workItemId, position])
}

model WorkItemLabel {
  id        String              @id @default(cuid())
  projectId String
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  items     WorkItemLabelLink[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}

model WorkItemLabelLink {
  id         String        @id @default(cuid())
  workItemId String
  workItem   WorkItem      @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  labelId    String
  label      WorkItemLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([workItemId, labelId])
  @@index([labelId])
}

model WorkItemDependency {
  id            String   @id @default(cuid())
  blockedItemId String
  blockedItem   WorkItem @relation("WorkItemBlocked", fields: [blockedItemId], references: [id], onDelete: Cascade)
  blockerItemId String
  blockerItem   WorkItem @relation("WorkItemBlocker", fields: [blockerItemId], references: [id], onDelete: Cascade)
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([blockedItemId, blockerItemId])
  @@index([blockerItemId])
}

model WorkItemComment {
  id             String            @id @default(cuid())
  workItemId     String
  workItem       WorkItem          @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         WorkItemComment?  @relation("WorkItemCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        WorkItemComment[] @relation("WorkItemCommentReplies")
  content        String
  createdById    String?
  createdBy      User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdByName  String?
  createdByEmail String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([workItemId, createdAt])
  @@index([parentId])
}

model RequirementTag {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  code         String
  kind         String
  label        String
  selectedText String?
  selector     String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([documentId, code])
  @@index([projectId, kind])
}

model TraceLink {
  id               String    @id @default(cuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceDocumentId String?
  sourceDocument   Document? @relation("TraceSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  targetDocumentId String?
  targetDocument   Document? @relation("TraceTargetDocument", fields: [targetDocumentId], references: [id], onDelete: SetNull)
  sourceCode       String
  sourceLabel      String
  targetCode       String
  targetLabel      String
  relation         String    @default("traces")
  createdBy        String?
  createdAt        DateTime  @default(now())

  @@index([projectId])
  @@index([sourceDocumentId])
  @@index([targetDocumentId])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  message    String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model DocumentTemplate {
  id          String   @id @default(cuid())
  name        String
  type        String
  description String?
  htmlContent String
  isSystem    Boolean  @default(false)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, isSystem])
}

model MediaAsset {
  id                 String    @id @default(cuid())
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId         String?
  document           Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  cloudinaryPublicId String
  url                String
  mimeType           String?
  size               Int?
  width              Int?
  height             Int?
  uploadedBy         String?
  createdAt          DateTime  @default(now())

  @@index([projectId, documentId])
}

model ImportJob {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId     String?      @unique
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sourceFileName String
  sourceFileType String
  sourceFileUrl  String?
  status         ImportStatus @default(PENDING)
  errorMessage   String?
  createdBy      String?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?
}
