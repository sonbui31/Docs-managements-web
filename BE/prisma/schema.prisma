generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SIGNED_OFF
  ARCHIVED
}

enum CommentStatus {
  OPEN
  RESOLVED
}

enum ImportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum GlobalRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum ProjectRole {
  VIEWER
  REVIEWER
  EDITOR
  MANAGER
}

enum TokenType {
  EMAIL_CONFIRMATION
  PASSWORD_RESET
}

model Project {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  client      String?
  description String?
  documents   Document[]
  mediaAssets MediaAsset[]
  importJobs  ImportJob[]
  members     ProjectMember[]
  documentPermissions DocumentPermission[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Document {
  id              String            @id @default(cuid())
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  type            String
  status          DocumentStatus    @default(DRAFT)
  currentVersion  String            @default("v0.1")
  htmlContent     String
  sourceType      String            @default("manual")
  sourceFileName  String?
  versions        DocumentVersion[]
  comments        Comment[]
  mediaAssets     MediaAsset[]
  importJob       ImportJob?
  permissions     DocumentPermission[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([projectId])
}

model User {
  id                    String           @id @default(cuid())
  email                 String           @unique
  passwordHash          String
  name                  String
  globalRole            GlobalRole       @default(EMPLOYEE)
  status                UserStatus       @default(ACTIVE)
  failedLoginAttempts   Int              @default(0)
  lockedUntil           DateTime?
  emailConfirmedAt      DateTime?
  deletedAt             DateTime?
  refreshSessions       RefreshSession[]
  projectMemberships    ProjectMember[]
  documentPermissions   DocumentPermission[]
  verificationTokens    VerificationToken[]
  auditLogs             AuditLog[]       @relation("AuditActor")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([globalRole, status])
}

model RefreshSession {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  lastUsedAt      DateTime?

  @@index([userId, expiresAt])
}

model ProjectMember {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ProjectRole @default(VIEWER)
  assignedBy  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([projectId, userId])
  @@index([userId, role])
}

model DocumentPermission {
  id          String      @id @default(cuid())
  documentId  String
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ProjectRole @default(VIEWER)
  assignedBy  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([documentId, userId])
  @@index([projectId, userId])
}

model VerificationToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  type        TokenType
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, type, expiresAt])
}

model AuditLog {
  id          String    @id @default(cuid())
  actorId     String?
  actor       User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version     String
  htmlContent String
  changeNote  String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@unique([documentId, version])
}

model Comment {
  id          String        @id @default(cuid())
  documentId  String
  document    Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parentId    String?
  blockId     String
  selectedText String?
  content     String
  status      CommentStatus @default(OPEN)
  createdBy   String?
  resolvedBy  String?
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  @@index([documentId, blockId])
  @@index([parentId])
}

model MediaAsset {
  id                 String    @id @default(cuid())
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId         String?
  document           Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  cloudinaryPublicId String
  url                String
  mimeType           String?
  size               Int?
  width              Int?
  height             Int?
  uploadedBy         String?
  createdAt          DateTime  @default(now())

  @@index([projectId, documentId])
}

model ImportJob {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId     String?      @unique
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sourceFileName String
  sourceFileType String
  sourceFileUrl  String?
  status         ImportStatus @default(PENDING)
  errorMessage   String?
  createdBy      String?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?
}
